{
  "name": "soundcloud-control-wxt",
  "description": "Extension para controlar SoundCloud sin cambiar de pestana",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "node scripts/delete-zips.js && wxt zip -b firefox",
    "zip:all": "node scripts/delete-zips.js && wxt zip && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "btch-downloader": "^6.0.27",
    "btch-http": "^2.0.3",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.4",
    "tailwindcss": "^4.2.4",
    "terser": "^5.47.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.25"
  }
}
